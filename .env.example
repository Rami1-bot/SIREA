# ============================================================
# SIREA - PLANTILLA DEL .env  (SIRE v6 + asistentes de IA)
# Copiar a ".env" y reemplazar solo los valores marcados con  <<< COMPLETAR
# Reglas: una variable por linea, SIN comillas, SIN espacios alrededor del "=".
# Nunca subir este archivo con valores reales a GitHub ni compartirlo.
# ============================================================

# ------------------------------------------------------------
# 1. BASE DE DATOS (Supabase) - proyecto de DEMO, separado de produccion
# ------------------------------------------------------------
DB_TYPE=supabase
# <<< COMPLETAR  https://xxxx.supabase.co
SUPABASE_URL=
# Clave SECRETA (service_role / sb_secret_...), NO la anon/publishable.
# <<< COMPLETAR
SUPABASE_KEY=

# ------------------------------------------------------------
# 2. ALMACENAMIENTO (Google Drive, cuenta de servicio)
# ------------------------------------------------------------
STORAGE_MODE=drive
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
# Si Drive falla, NO se pasa a guardar en el servidor en silencio (los envios quedarian fuera de Drive).
# Solo para pruebas: STORAGE_FALLBACK_LOCAL=true
STORAGE_FALLBACK_LOCAL=false
# Las 3 carpetas deben estar compartidas con la cuenta de servicio como Editor
# (o Gestor de contenido). Solo el ID (lo que va despues de /folders/).
# <<< COMPLETAR  carpeta principal de envios
GOOGLE_DRIVE_FOLDER_ID=
# <<< COMPLETAR  carpeta de duplicados
GOOGLE_DRIVE_FOLDER_DUPLICADOS_ID=
# Opcional: carpeta de Drive para los envíos reemplazados (si se deja vacío se crea REEMPLAZADOS dentro de la principal)
GOOGLE_DRIVE_FOLDER_REEMPLAZADOS_ID=
# <<< COMPLETAR  carpeta de respaldos
GOOGLE_DRIVE_FOLDER_BACKUPS_ID=

# ------------------------------------------------------------
# 3. CORREO (SMTP Gmail / Google Workspace)
# ------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# <<< COMPLETAR  cuenta que envia
EMAIL_REMITENTE=
# Contrasena de APLICACION de Google (16 caracteres, sin espacios), no la normal.
# <<< COMPLETAR
EMAIL_PASSWORD=
EMAIL_NOMBRE_MOSTRAR=SIREA - OIIS EsSalud
# <<< COMPLETAR  donde llegan las respuestas
EMAIL_REPLY_TO=
# Correo de consultas mostrado en el inicio y al pie de los correos.
# <<< COMPLETAR (si se deja vacio usa EMAIL_REPLY_TO)
CONTACTO_EMAIL=
# Reciben alertas y avisos de los administradores (separados por coma, sin espacios).
# <<< COMPLETAR
EMAIL_ADMINS=
# Respaldo si EMAIL_ADMINS queda vacio.
# <<< COMPLETAR
ADMIN_EMAIL=
ADMIN_NOMBRE=OIIS

# Conexion a Supabase: por defecto HTTP/1.1 con reintento de lecturas (evita los cortes
# "WinError 10035" / "ConnectionTerminated" en Windows). Solo poner true para volver al comportamiento anterior.
SUPABASE_HTTP2=false

# ------------------------------------------------------------
# 4. SEGURIDAD Y TRAZABILIDAD (v6)
# ------------------------------------------------------------
# Unico SUPER_ADMIN que asigna permisos, aprueba retiros, edita otras cuentas
# y usa los asistentes "Analista de control" y "Pre-evaluador de solicitudes".
SUPERADMIN_PRINCIPAL=oiis.winepi
# Buzon institucional que recibe copia oculta (BCC) de los acuses de descarga y retiro.
# Es el registro independiente de la base de datos. Idealmente un buzon que NO use ningun admin.
# <<< COMPLETAR (muy recomendado)
AUDITORIA_COPIA_EMAIL=
# Peso maximo (MB) de cada ZIP de descarga masiva; si la semana pesa mas, se parte en varios.
DESCARGA_MASIVA_MAX_MB=250
# Un retiro de mas archivos que este numero se marca como senal para revisar.
ALERTA_RETIRO_MAX_ARCHIVOS=50
# Horario laboral (hora de Lima, 0-23): lo hecho fuera de el se marca como senal.
HORARIO_LABORAL_INICIO=7
HORARIO_LABORAL_FIN=20
# Horas de validez del permiso para que una red cambie su contrasena tras ser aprobada.
HORAS_VALIDEZ_CAMBIO_PASSWORD=24

# ------------------------------------------------------------
# 4b. HTTPS (opcional, recomendado) - ver GUIA_DESPLIEGUE_WINDOWS.md
# ------------------------------------------------------------
# 0.0.0.0 = la app se abre directo en http://<equipo>:8501 (sin cifrar).
# 127.0.0.1 = solo el propio equipo; el personal entra por HTTPS con:  docker compose --profile https up -d
APP_BIND=0.0.0.0
# Nombre del equipo o IP por la que entrara el personal (solo con HTTPS).
SIRE_HOST=localhost
# true SOLO si se usa el proxy HTTPS de arriba; asi la auditoria anota la IP real del visitante.
PROXY_CONFIABLE=false

# ------------------------------------------------------------
# 5. PROCESO PROGRAMADO (contenedor "programador")
# ------------------------------------------------------------
TZ=America/Lima
RECORDATORIOS_CIERRE_HORAS=08:00,12:00,16:00
# Respaldo automatico cada N cortes.
RESPALDO_CADA_N_CORTES=2
# Un corte vencido hace mas de estas horas NO se procesa solo.
CIERRE_VENTANA_HORAS=72
# Minutos sin latido tras los cuales el panel avisa que el programador dejó de responder.
# Docker (ciclo cada minuto): 5. Streamlit Cloud + GitHub Actions (cada 15 min): 40.
PROGRAMADOR_LATIDO_MAX_MIN=5

# ------------------------------------------------------------
# 6. ARCHIVOS PERMITIDOS
# ------------------------------------------------------------
EXTENSIONES_PERMITIDAS=.xlsx,.csv,.xls,.dbf
PERMITIR_EXTENSIONES_NUMERICAS=true

# ------------------------------------------------------------
# 7. VALORES DE RESPALDO (el panel de administracion / tabla "configuracion"
#    de Supabase tiene prioridad; estos solo se usan si falta el dato alli)
# ------------------------------------------------------------
SEMANA_ACTUAL=40
FECHA_CORTE=2026-10-21 23:59:59
TAMANO_MAXIMO_ZIP_MB=60
DIAS_TOLERANCIA_ATRASO=0
PERMITIR_ANIOS_ANTERIORES=true
PERMITIR_ENVIOS_ADELANTADOS=false

# ------------------------------------------------------------
# 8. GENERAL
# ------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ------------------------------------------------------------
# 9. ASISTENTES DE IA (nuevo en SIREA)
# ------------------------------------------------------------
# Orden de proveedores: el primero es el principal, el resto respaldo.
# Los guardrails, la auditoria y la supervision humana son los mismos
# para todos los proveedores.
IA_PROVEEDOR_ORDEN=gemini,groq
# Gemini (Google AI Studio): https://aistudio.google.com/app/apikey
# <<< COMPLETAR
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Modelos de respaldo de Gemini si el principal falla (vacio = lista interna).
# Revisar nombres vigentes en https://ai.google.dev/gemini-api/docs/models
GEMINI_MODELOS_RESPALDO=
# Groq (respaldo, capa gratuita): https://console.groq.com  - API compatible con OpenAI.
# <<< COMPLETAR
GROQ_API_KEY=
# Modelo gratuito de Groq. Si el nombre no existe (Groq cambia el catalogo cada
# cierto tiempo) SIREA elige solo el primero disponible de GROQ_MODELOS_RESPALDO
# y lo indica en "Probar los proveedores de IA".
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODELOS_RESPALDO=llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Segundos de espera por respuesta antes de pasar al siguiente proveedor.
IA_TIMEOUT_SEGUNDOS=30
# Tope de consultas a herramientas por pregunta (investigador).
IA_MAX_TOOL_CALLS=8
# Agente Operativo: corre solo (con el programador) en dias habiles desde esta hora de Lima.
AGENTE_PROGRAMADO=true
AGENTE_HORA=9
# Aprender de los rechazos: rechazos con motivo necesarios para proponer una mejora de skill.
AGENTE_MIN_RECHAZOS_MEJORA=3
# Centro de pendientes: % de Drive desde el que se avisa, y antigüedad mínima (semanas) para sugerir liberar.
ALMACENAMIENTO_UMBRAL_PCT=80
ALMACENAMIENTO_SEMANAS_ANTIGUEDAD=4
# SIREA 3.2 · Patrones: semanas que se miran hacia atrás y mínimo para hablar de «patrón».
PATRONES_SEMANAS=8
PATRONES_MIN_SEMANAS=4
# SIREA 3.2 · Asistente en todas las pantallas: preguntas por hora por sesión (cuida la cuota del proveedor).
ASISTENTE_LIMITE_HORA=30
# Los asistentes SIEMPRE arrancan inactivos; se activan desde el panel (SUPER_ADMIN).
# No hay variable para saltarse eso: es un control de gobernanza.

# ------------------------------------------------------------
# 10. SESIONES Y BLOQUEOS DE LOGIN (persistentes en Supabase; sql/51)
# ------------------------------------------------------------
SESION_DURACION_HORAS=8
SESION_INACTIVIDAD_MINUTOS=30
LOGIN_MAX_INTENTOS_USUARIO=5
LOGIN_MAX_INTENTOS_IP=20
LOGIN_BLOQUEO_MINUTOS=15

# NOTAS
# - No hay ADMIN_USER / ADMIN_PASSWORD: el login de administradores esta en la tabla
#   "administradores" de Supabase.
# - Ya NO hacen falta DB_PATH, DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD,
#   GOOGLE_AUTH_TYPE ni LOG_FORMAT (SIGRE los arrastraba; SIREA no los usa).
